# BOOKIA Mobile: variables for `docker compose` (API + seed).
# Copy to .env and fill in the blanks. NEVER commit .env (DOC-04).
#   Git Bash:   cp .env.example .env
#   PowerShell: copy .env.example .env
# NODE_ENV, PORT and MONGODB_URI are set by docker-compose.yml; do not add them here.

# Required. Long random string used to sign the session tokens (JWT).
# Generate one with: openssl rand -hex 48
JWT_SECRET=

# Required by the seed. Admin account created by `npm run seed`.
ADMIN_EMAIL=admin@bookia.local
# Required by the seed. At least 8 characters.
ADMIN_PASSWORD=

# Optional. Session length in seconds (default 28800 = 8 h).
JWT_EXPIRES_IN_SECONDS=28800
# Optional. bcrypt cost for password hashes (the API enforces a minimum of 10).
BCRYPT_SALT_ROUNDS=12
# Optional. Origin allowed by CORS for the web client; the mobile app does not need it.
CLIENT_URL=http://localhost:5173

# Optional. Path to the api/ folder of the bookia repo, if it is not where
# docker-compose.yml expects it. Uncomment and adjust only if the build cannot find the API.
# BOOKIA_API_PATH=../bookia/api

# Load the test data (first time only; run again to reset the catalog):
#   docker compose up -d
#   docker compose --profile tools run --rm seed
